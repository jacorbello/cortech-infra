                  "condition": "state",
                  "entity": "binary_sensor.zenwifi_bq16_pro_77f8_wan_status",
                  "state": "off"
                }
              ],
              "card": {
                "type": "markdown",
                "content": "## Internet is down\nThe router reports no WAN connectivity."
              }
            },
            {
              "type": "conditional",
              "conditions": [
                {
                  "condition": "numeric_state",
                  "entity": "sensor.mfc_j6960dw_black_toner_remaining",
