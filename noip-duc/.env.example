# Environment for noip-duc.service on the proxy LXC (PCT 100).
# Real file lives at: /etc/default/noip-duc  (owned by root:root, mode 0600)
# It IS a systemd EnvironmentFile — noip-duc reads these as NOIP_* env vars.
# Pull the values from Infisical (dev); never commit the real key.

# DDNS Key credentials — No-IP portal → Dynamic DNS → DDNS Keys.
# Scoped to DNS updates only; a leak here cannot take over the No-IP account.
# These are NOT the No-IP account username/password.
NOIP_USERNAME=
NOIP_PASSWORD=

# Comma-separated hostnames, or a DDNS Key group. `all.ddnskey.com` = every hostname
# attached to the key above, so adding a hostname later needs no change on the guest.
NOIP_HOSTNAMES=all.ddnskey.com

# Tunables. Defaults are correct behind NAT — knobs, not config for its own sake.
# NOIP_CHECK_INTERVAL=5m    # default 5m, minimum 2m; No-IP flags clients that poll faster
# NOIP_IP_METHOD=dns,http   # 'dns' = No-IP's own reflection, which sees the WAN IP, not the veth
# NOIP_LOG_LEVEL=info
